---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · Page not found" description="La página que buscas no existe. · The page you’re looking for doesn’t exist." noindex>
  <section class="wrap section" style="display:grid; gap: var(--sp-5); justify-items:start">
    <p class="eyebrow">Error 404</p>
    <h1 class="h1">Este sendero <em class="it-accent">no lleva a ningún lado.</em></h1>
    <p class="lead">La página que buscas no existe o cambió de lugar. <span lang="en">· This page doesn’t exist or has moved.</span></p>
    <div class="cta-row"><a class="btn" href="/">Volver al inicio</a><a class="btn btn--ghost" href="/en/" lang="en">English home</a></div>
  </section>
</Base>
