---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada / Page not found" description="La página que buscas no existe.">
  <section class="wrap section" style="display:grid; gap: var(--sp-5); justify-items:start">
    <p class="eyebrow">Error 404</p>
    <h1 class="h1">Este camino <em class="wonk">no lleva a Turín.</em></h1>
    <p class="lead">La página que buscas no existe. · This page doesn’t exist.</p>
    <div style="display:flex; gap: var(--sp-3); flex-wrap: wrap">
      <a class="btn" href="/">Inicio</a>
      <a class="btn btn--ghost" href="/en/">Home (English)</a>
    </div>
  </section>
</Base>
