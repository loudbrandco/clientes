{
  "name": "zena-ecosistema",
  "private": true,
  "description": "Ecosistema digital: zenaayoub.com + theadventurerscf.org",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:zena": "npm run dev -w apps/zena",
    "dev:fundacion": "npm run dev -w apps/fundacion",
