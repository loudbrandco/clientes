---
// Imagen responsive a partir de las versiones WebP generadas en /public/img.
// Uso: <Img name="zena-arbol" widths={[600,1000,1500]} alt="..." />
interface Props {
  name: string; widths: number[]; alt: string; sizes?: string;
  class?: string; eager?: boolean; width?: number; height?: number; style?: string;
}
const { name, widths, alt, sizes = '100vw', class: cls, eager = false, width, height, style } = Astro.props;
const srcset = widths.map((w) => `/img/${name}-${w}.webp ${w}w`).join(', ');
const src = `/img/${name}-${widths[widths.length - 1]}.webp`;
---
<img
  src={src} srcset={srcset} sizes={sizes} alt={alt} class={cls} style={style}
  width={width} height={height}
  loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
/>
