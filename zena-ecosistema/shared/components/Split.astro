---
// Titular que aparece línea por línea. Pasa las líneas como arreglo.
// Uso: <Split as="h1" class="display" lines={["Historias que", "nos devuelven"]} />
interface Props { as?: string; lines: string[]; class?: string; delay?: number; id?: string }
const { as: Tag = 'h2', lines, class: cls, delay = 0, id } = Astro.props;
---
<Tag class={cls} data-split id={id} aria-label={lines.join(' ')}>
  {lines.map((l, i) => (
    <span class="split-line" aria-hidden="true"><span style={`--d:${delay + i * 110}ms`} set:html={l} /></span>
  ))}
</Tag>
